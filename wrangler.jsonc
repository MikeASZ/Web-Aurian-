{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "aurian-menu",
    "main": "src/worker.js",
    "compatibility_date": "2026-11-07",
    "workers_dev": true,
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "aurian",
            "database_id": "REEMPLAZAR_CON_ID_REAL_DE_D1",
            "migrations_dir": "migrations"
        }
    ],
    "observability": {
        "enabled": false
    }
}
